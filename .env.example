# Prototype endpoints
MEDIA_SERVICE_MAX_UPLOAD_BYTES=10485760
MEDIA_SERVICE_METADATA_PATH=.data/media_metadata.json
# MEDIA_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OCR runtime. The binary is auto-detected on Windows; the language data is not shipped with it
# -- the system install has eng and not sin, so TESSERACT_TESSDATA_DIR (or the project-local
# .tessdata) is what makes Sinhala work.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_TESSDATA_DIR=.tessdata

# OCR provider: tesseract | paddle_tesseract | vision_llm.
# vision_llm is recognised but arrives with Phase 3.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=sin+eng
OCR_CONCURRENCY=2
OCR_TIMEOUT_SECONDS=60
OCR_EMPTY_TEXT_MIN_CHARS=8
OCR_LOW_CONFIDENCE_THRESHOLD=0.60

# Preprocessing. Orientation is always applied. The rest default off because they were measured
# against the regression corpus: greyscale and autocontrast left every case identical, while
# denoising and thresholding both lowered mean confidence on clean scans.
OCR_PREPROCESS_VERSION=preprocess/v1
OCR_PREPROCESS_GRAYSCALE=true
OCR_PREPROCESS_AUTOCONTRAST=false
OCR_PREPROCESS_DENOISE=false
# OCR_PREPROCESS_THRESHOLD=128
OCR_PREPROCESS_DESKEW=false

# Tesseract tuning. 3/3 is automatic page segmentation with the LSTM engine, the only one with a
# Sinhala model; 6 is "one uniform block", used inside a detected region.
OCR_TESSERACT_PSM=3
OCR_TESSERACT_OEM=3
OCR_TESSERACT_REGION_PSM=6

# Paddle hybrid: detection only, because PaddleOCR has no Sinhala recognition model. Install with
# `pip install -e ".[paddle]"`. Absent, the hybrid degrades to whole-page Tesseract and marks it.
OCR_PADDLE_FALLBACK_TO_TESSERACT=true
OCR_PADDLE_DEVICE=cpu
OCR_PADDLE_BOX_THRESH=0.5
OCR_PADDLE_MERGE_IOU=0.1
OCR_PADDLE_MAX_REGIONS=40
# OCR_PADDLE_MODEL_DIR=

# LLM provider: openai_compatible | gemini | anthropic | fake | rule_based.
# fake and rule_based invent advertisements without a model, so the service refuses to construct
# them outside local and test -- at startup, not at extraction time.
LLM_PROVIDER=fake
LLM_FAKE_MODE=rule_based
# LLM_FAKE_FIXTURE_DIR=
# MEDIA_SERVICE_ALLOW_FAKE_PROVIDERS=true

LLM_PROMPT_VERSION=v1
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OCR_CHARS=24000
LLM_MAX_CANDIDATES_PER_IMAGE=20
LLM_CONCURRENCY=4

# Two independent budgets. A rate limit must not consume the item's one repair, and a schema
# failure must not eat the retries it may need afterwards.
LLM_MAX_ATTEMPTS=3
LLM_MAX_REPAIRS=1
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=20.0
LLM_TOTAL_DEADLINE_SECONDS=240

# auto picks by base URL: hosts that do not implement strict json_schema degrade to json_object
# rather than failing every request with a 400 naming a parameter nobody chose.
LLM_STRUCTURED_MODE=auto

# OpenAI and anything speaking its protocol -- OpenRouter, Groq, Together, vLLM, LM Studio.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# The key travels in the x-goog-api-key header, never ?key=, which would land in proxy logs.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=
# GEMINI_THINKING_BUDGET=

# Structure comes from a forced tool call: the tool input is the payload, so no text is parsed.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_API_KEY=

# Database (PostgreSQL in every environment, including tests)
DATABASE_URL=postgresql+psycopg://lankalistings:lankalistings@localhost:5434/lankalistings
TEST_DATABASE_URL=postgresql+psycopg://lankalistings:lankalistings@localhost:5434/lankalistings_test

# Blob storage
MEDIA_STORAGE_ROOT=.data/media

# Batch limits. The total is binding and is checked first: 25 images at the per-image
# limit would be 250 MiB, which the total forbids.
MAX_IMAGES_PER_BATCH=25
MAX_IMAGE_BYTES=10485760
MAX_BATCH_BYTES=104857600
# Declared pixels, checked before anything decodes a full buffer. Pillow's own guard only warns
# between its limit and twice its limit, which leaves a band where a small file is huge in memory.
MAX_IMAGE_PIXELS=40000000

# Worker: local_pool | inline | manual | none
JOB_DISPATCH_MODE=local_pool
MAX_WORKER_CONCURRENCY=2
LEASE_SECONDS=300
HEARTBEAT_SECONDS=30
POLL_INTERVAL_MS=2000
REAPER_INTERVAL_MS=15000
MAX_ITEM_ATTEMPTS=3
# true requeues everything in flight at startup. Correct only with one worker running.
WORKER_SINGLE_INSTANCE=true

# Access control: none | static_token. `none` is refused outside local and test.
OPERATOR_AUTH_MODE=none
# OPERATOR_API_TOKEN=

# Wire compatibility
MEDIA_SERVICE_ENV=local
MEDIA_REPOSITORY=json
PUBLIC_IMAGE_URL_MODE=data_url
ADVERTISEMENT_STATUS_WIRE=legacy
