# Prototype endpoints
MEDIA_SERVICE_MAX_UPLOAD_BYTES=10485760
MEDIA_SERVICE_METADATA_PATH=.data/media_metadata.json
# MEDIA_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OCR runtime
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=sin+eng
# TESSERACT_TESSDATA_DIR=.tessdata

# Database (PostgreSQL in every environment, including tests)
DATABASE_URL=postgresql+psycopg://lankalistings:lankalistings@localhost:5434/lankalistings
TEST_DATABASE_URL=postgresql+psycopg://lankalistings:lankalistings@localhost:5434/lankalistings_test

# Blob storage
MEDIA_STORAGE_ROOT=.data/media

# Batch limits. The total is binding and is checked first: 25 images at the per-image
# limit would be 250 MiB, which the total forbids.
MAX_IMAGES_PER_BATCH=25
MAX_IMAGE_BYTES=10485760
MAX_BATCH_BYTES=104857600

# Worker: local_pool | inline | manual | none
JOB_DISPATCH_MODE=local_pool
MAX_WORKER_CONCURRENCY=2
LEASE_SECONDS=300
HEARTBEAT_SECONDS=30
POLL_INTERVAL_MS=2000
REAPER_INTERVAL_MS=15000
MAX_ITEM_ATTEMPTS=3
# true requeues everything in flight at startup. Correct only with one worker running.
WORKER_SINGLE_INSTANCE=true

# Access control: none | static_token. `none` is refused outside local and test.
OPERATOR_AUTH_MODE=none
# OPERATOR_API_TOKEN=

# Wire compatibility
MEDIA_SERVICE_ENV=local
MEDIA_REPOSITORY=json
PUBLIC_IMAGE_URL_MODE=data_url
ADVERTISEMENT_STATUS_WIRE=legacy
